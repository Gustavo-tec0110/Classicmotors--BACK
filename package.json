{
  "name": "classic-motors-api",
  "version": "1.0.0",
  "description": "API backend do Classic Motors",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "db:init-cars": "node src/database/init.js",
    "db:seed-catalog": "node src/database/seed.js",
    "db:init-users": "node src/scripts/init-users.js",
    "check": "node --check index.js && node --check app.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run check",
    "test": "node --test"
  },
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2"
  }
}
